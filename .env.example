# Copy to .env and adjust as needed. Defaults work for local development.

POSTGRES_USER=bbq
POSTGRES_PASSWORD=bbq
POSTGRES_DB=bbq
# Host port for Postgres. 5433 by default to avoid clashing with a local install.
POSTGRES_PORT=5433

API_PORT=3001
WEB_PORT=3000

# Where the browser reaches the API.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Origins allowed by CORS (comma-separated).
WEB_ORIGIN=http://localhost:3000

# Per-file upload ceiling for issue photos.
MAX_UPLOAD_MB=10
